# API settings
ENVIRONMENT=development
DATABASE_URL=sqlite:///./astra.db
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# GitHub REST boundary. Credentials are supplied by the eventual user-scoped auth flow,
# never configured here as a shared token.
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_REQUEST_TIMEOUT_SECONDS=10
FRONTEND_URL=http://localhost:3000

# GitHub App user-authorization flow. Obtain these from the GitHub App settings.
# Create a Fernet key with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:8000/github/callback
TOKEN_ENCRYPTION_KEY=

# Planning only. Astra does not run code from this model request.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
